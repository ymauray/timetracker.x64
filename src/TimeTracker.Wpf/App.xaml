<Application x:Class="TimeTracker.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TimeTracker.Wpf.Views"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <views:TonBrushConverter x:Key="TonBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
        <views:TextVisibilityConverter x:Key="TexteVisible" />

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="Background" Value="#14808080" />
        </Style>

        <Style x:Key="Legende" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Alerte" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9822B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Application.Resources>
</Application>
