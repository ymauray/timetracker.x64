<Window x:Class="TimeTracker.Wpf.Views.EditionJourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimeTracker.Wpf.ViewModels"
        Title="{Binding Titre}" Icon="/Assets/pointage.ico" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Date" Margin="0,0,0,2" Visibility="{Binding EstAjout, Converter={StaticResource BoolVisible}}" />
        <DatePicker SelectedDate="{Binding Date}" Margin="0,0,0,12"
                    Visibility="{Binding EstAjout, Converter={StaticResource BoolVisible}}" />

        <TextBlock Text="Absence" Margin="0,0,0,2" />
        <ComboBox ItemsSource="{x:Static vm:EditionJourViewModel.Choix}" SelectedItem="{Binding AbsenceChoisie}"
                  DisplayMemberPath="Libelle" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Arrivée" Margin="0,0,0,2" />
            <TextBox Grid.Row="1" Text="{Binding Arrivee, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="Départ" Margin="0,0,0,2" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Depart, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Text="Début pause" Margin="0,10,0,2" />
            <TextBox Grid.Row="3" Text="{Binding DebutPause, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Fin pause" Margin="0,10,0,2" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding FinPause, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Text="Format : 8h50 ou 8:50. Une journée sans pause saisie perd quand même la pause minimum."
                   Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock Text="{Binding Erreur}" Foreground="#D13B30" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Erreur, Converter={StaticResource TexteVisible}}" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Supprimer la journée" Click="Supprimer_Click"
                    Visibility="{Binding PeutSupprimer, Converter={StaticResource BoolVisible}}" />
            <Button DockPanel.Dock="Right" Content="Enregistrer" IsEnabled="{Binding EstValide}" IsDefault="True"
                    Click="Enregistrer_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,5" />
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="0,0,8,0" Padding="14,5" />
        </DockPanel>
    </StackPanel>
</Window>
